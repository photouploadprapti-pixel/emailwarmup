# Optional. 64-character hex key used to encrypt mailbox passwords.
# If omitted, Hearth derives a stable key from the Vercel project id.
ENCRYPTION_KEY=replace-with-a-64-character-hex-string

# Required on Vercel if you want mailboxes to persist across deploys.
# Create a free database at https://turso.tech and paste the URL + token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. If set, Vercel Cron must send Authorization: Bearer <secret>
CRON_SECRET=
